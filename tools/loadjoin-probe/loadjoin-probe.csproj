<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>loadjoin-probe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Program.cs only, and deliberately no Reference items: every type this tool touches (game, host mod,
    Harmony, the patch itself) is loaded from disk at run time, so a missing or renamed member is one printed
    line instead of a build error - the same reason the patch resolves its anchors by name.

    Overrides: loadjoin-probe.exe <gameDir> <hostDll> <patchDll>
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
